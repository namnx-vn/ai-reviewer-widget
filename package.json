{
  "name": "ai-reviewer-widget",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist/cli"
  ],
  "bin": {
    "ai-reviewer": "dist/cli/ai-reviewer.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.cli.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:evaluation": "vitest run src/evaluation/__tests__",
    "evaluation:report": "tsx scripts/evaluation-quality-report.ts",
    "evaluation:real-world-report": "tsx scripts/real-world-observation-report.ts",
    "test:e2e": "playwright test",
    "test:package": "npm run build && vitest run --config vite.package-test.config.ts",
    "test:watch": "vitest",
    "security:secrets": "tsx scripts/secret-scan.ts",
    "review:pr": "tsx scripts/review-pr.ts",
    "review:local": "tsx scripts/ai-reviewer.ts",
    "benchmark:review": "tsx scripts/benchmark-review.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@typescript-eslint/typescript-estree": "^8.68.0",
    "antd": "^6.6.2",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
